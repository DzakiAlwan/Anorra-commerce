# Supabase session pooler (Project Settings -> Database -> Connect)
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"

NODE_ENV="development"

# Kunci penandatangan session admin (minimal 32 karakter acak)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Supabase Storage (upload gambar produk)
# Secret key hanya dipakai di server; jangan pakai prefix NEXT_PUBLIC_.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Local Postgres alternative
# DATABASE_URL="postgresql://anorra:anorra@localhost:5432/anorra?schema=public"
